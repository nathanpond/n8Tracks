<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors> <!-- Agreed with the team: the legacy module is too noisy to fix this quarter. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <EnableNETAnalyzers>true</EnableNETAnalyzers> <!-- Agreed with the team: the legacy module is too noisy to fix this quarter. -->
  </PropertyGroup>
</Project>
