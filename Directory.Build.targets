<Project>
  <!--
    Guards the root VERSION file (see Directory.Build.props). Runs before restore and before build,
    so a broken VERSION file never silently falls back to the SDK's default 1.0.0.
  -->
  <Target Name="ValidateProductVersionFile" BeforeTargets="CollectPackageReferences;BeforeBuild">
    <Error Condition="!Exists('$(ProductVersionFile)')"
           Text="The product version file '$(ProductVersionFile)' is missing. It must hold the product version, for example 0.1.0." />
    <Error Condition="Exists('$(ProductVersionFile)') And '$(ProductVersionFromFile)' == ''"
           Text="The product version file '$(ProductVersionFile)' is empty. It must hold the product version, for example 0.1.0." />
    <Error Condition="'$(ProductVersionFromFile)' != '' And !$([System.Text.RegularExpressions.Regex]::IsMatch('$(ProductVersionFromFile)', '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'))"
           Text="The product version file '$(ProductVersionFile)' holds '$(ProductVersionFromFile)', which is not a major.minor.patch version such as 0.1.0." />
  </Target>
</Project>
