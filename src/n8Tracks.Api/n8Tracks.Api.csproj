<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="n8Tracks.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\n8Tracks.Application\n8Tracks.Application.csproj" />
    <ProjectReference Include="..\n8Tracks.Infrastructure\n8Tracks.Infrastructure.csproj" />
    <ProjectReference Include="..\n8Tracks.ServiceDefaults\n8Tracks.ServiceDefaults.csproj" />
  </ItemGroup>

  <!-- Local runs use ./.localdata as the data path (see Properties/launchSettings.json); it is git-ignored. -->
  <Target Name="CreateLocalDataDirectory" BeforeTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <MakeDir Directories="$(MSBuildProjectDirectory)/.localdata" />
  </Target>

</Project>
