#!/bin/sh
# The n8tracks command on the image's PATH, for an owner at a shell in a running container:
#
#   docker exec -it <container> n8tracks reset-password
#   printf '%s\n' "$NEW_PASSWORD" | docker exec -i <container> n8tracks reset-password --password-stdin
#
# It runs the app binary with the given command, as the user the app runs as, so the files the
# command touches keep their owner. Run as root (docker exec's default), it drops to PUID:PGID (default
# 1000:1000) with no supplementary groups, the way the entrypoint does. Run as another user
# (docker exec --user, or a container started with Docker's own user setting), it runs the command as
# that user. It changes no owner and starts no server: a command is required.

set -eu

# The chosen user usually has no passwd entry and so no home directory.
export HOME=/tmp

usage() {
    printf '%s\n' 'Usage: n8tracks reset-password [--password-stdin]' >&2
}

if [ "$#" -eq 0 ]; then
    usage
    exit 1
fi

case "$1" in
    reset-password) ;;
    *)
        printf 'Unknown command.\n' >&2
        usage
        exit 1
        ;;
esac

if [ "$(id -u)" != 0 ]; then
    exec dotnet /app/n8Tracks.Api.dll "$@"
fi

# is_id VALUE: a whole number from 0 to 4294967294, written with digits only (as in the entrypoint).
is_id() {
    case "$1" in
        '' | *[!0-9]*) return 1 ;;
    esac

    [ "${#1}" -le 10 ] && [ "$1" -le 4294967294 ]
}

puid=$(printf '%s' "${PUID:-1000}" | sed 's/^0*\([0-9]\)/\1/')
pgid=$(printf '%s' "${PGID:-1000}" | sed 's/^0*\([0-9]\)/\1/')
if ! is_id "$puid" || ! is_id "$pgid"; then
    printf 'Invalid configuration: PUID and PGID must be whole numbers from 0 to 4294967294.\n' >&2
    exit 1
fi

exec setpriv --reuid="$puid" --regid="$pgid" --clear-groups dotnet /app/n8Tracks.Api.dll "$@"
